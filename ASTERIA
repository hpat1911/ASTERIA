# GAS DYNAMICS, MASS TRANSFER & ACCRETION DISK ESTIMATION
# ============================================================

def l1_sound_speed(params: SystemParameters, Teff_avg_K: float) -> float:
    m_particle = params.mean_molecular_weight * M_H
    return float(np.sqrt(params.gamma_gas * K_B * Teff_avg_K / m_particle))

def conservative_mass_transfer_rate(orbit: OrbitalSolution, dP_dt_s_per_year: float) -> Tuple[float, float]:
    if dP_dt_s_per_year == 0.0:
        return 0.0, 0.0
    P = 2.0 * np.pi / orbit.omega_rad_s
    dP_dt = dP_dt_s_per_year / YEAR
    mdot_kg_s = ((dP_dt / (3.0 * P)) * (orbit.M1_kg * orbit.M2_kg) / (orbit.M2_kg - orbit.M1_kg))
    mdot_Msun_yr = mdot_kg_s * YEAR / M_SUN
    return float(mdot_kg_s), float(mdot_Msun_yr)

def ballistic_stream(roche: RocheModel, Teff_avg_K: float, params: SystemParameters, duration: float = 25.0) -> dict:
    v_l1 = l1_sound_speed(params, Teff_avg_K)
    xL1 = roche.lagrange_points()["L1"][0]
    
    def rhs(t, state):
        x, y, vx, vy = state
        r1, r2 = max(np.sqrt(x**2 + y**2), 1e-12), max(np.sqrt((x - roche.a)**2 + y**2), 1e-12)
        ax = -G * roche.M1 * x / r1**3 - G * roche.M2 * (x - roche.a) / r2**3 + 2.0 * roche.omega * vy + roche.omega**2 * (x - roche.x_cm)
        ay = -G * roche.M1 * y / r1**3 - G * roche.M2 * y / r2**3 - 2.0 * roche.omega * vx + roche.omega**2 * y
        return [vx, vy, ax, ay]

    sol = solve_ivp(rhs, (0.0, duration * DAY), [xL1 + 0.01 * R_SUN, 0.0, v_l1, 0.0], t_eval=np.linspace(0.0, duration * DAY, 1500), rtol=1e-8, atol=1e-8)
    return {"x_Rsun": sol.y[0] / R_SUN, "y_Rsun": sol.y[1] / R_SUN}

def estimate_accretion_disk(stream: dict, a_Rsun: float) -> float:
    x, y = stream["x_Rsun"], stream["y_Rsun"]
    far_side_mask = x > a_Rsun
    if not np.any(far_side_mask):
        return 0.0
    x_far, y_far = x[far_side_mask], y[far_side_mask]
    r_from_gainer = np.sqrt((x_far - a_Rsun)**2 + y_far**2)
    return float(np.max(r_from_gainer))
