def plot_fourier_fit(phase, mag, beta_fourier, fourier_eq):
    """Plots the raw photometric data against the mathematical Fourier model."""
    raw_flux = 10.0 ** (-0.4 * (mag - np.min(mag)))
    baseline = np.percentile(raw_flux, 99) 
    flux = raw_flux / baseline

    phi_grid = np.linspace(0, 1, 500)
    f_grid = evaluate_fourier(phi_grid, beta_fourier, order=4)

    fig, ax = plt.subplots(figsize=(10, 6))
    # Duplicate phase to show a full continuous cycle (Phase 0 to 2)
    ax.scatter(np.concatenate([phase, phase + 1.0]), np.concatenate([flux, flux]), 
               color='gray', s=15, alpha=0.5, label='Observational Data')
    ax.plot(np.concatenate([phi_grid, phi_grid + 1.0]), np.concatenate([f_grid, f_grid]), 
            color='red', linewidth=2.5, label='Fourier Fit (4th Order)')
    
    ax.set_xlabel("Orbital Phase", fontsize=12)
    ax.set_ylabel("Normalized Flux", fontsize=12)
    ax.set_title(f"Radiative Engine: Light Curve Model\n{fourier_eq}", fontsize=11)
    ax.legend(loc="lower right")
    ax.grid(True, linestyle=':', alpha=0.7)
    plt.tight_layout()
    plt.show()

def plot_equipotential_map(roche: RocheModel, orbit: OrbitalSolution, lagrange: dict):
    """Generates the 2D contour map of the Roche potential."""
    a_Rsun = orbit.a_m / R_SUN
    lim_x = a_Rsun * 2.0
    lim_y = a_Rsun * 1.5
    X, Y = np.meshgrid(np.linspace(-lim_x*0.4, lim_x*1.1, 400), np.linspace(-lim_y*0.8, lim_y*0.8, 400))
    
    Z = np.zeros_like(X)
    for i in range(X.shape[0]):
        for j in range(X.shape[1]):
            Z[i, j] = roche.potential(X[i, j] * R_SUN, Y[i, j] * R_SUN, 0.0)
            
    fig, ax = plt.subplots(figsize=(10, 8))
    levels = np.linspace(np.min(Z), np.percentile(Z, 98), 100)
    ax.contour(X, Y, Z, levels=levels, colors='gray', linewidths=0.5, alpha=0.6)
    
    # Highlight Lagrange potentials
    for name, color in zip(['L1', 'L2', 'L3'], ['blue', 'red', 'orange']):
        pot = roche.potential(*lagrange[name])
        ax.contour(X, Y, Z, levels=[pot], colors=color, linewidths=1.5, linestyles='--' if name != 'L1' else '-')

    ax.scatter([0], [0], color='blue', s=80, label='Donor Core', zorder=5)
    ax.scatter([a_Rsun], [0], color='red', s=80, label='Gainer Core', zorder=5)
    
    lagrange_colors = {'L1': 'black', 'L2': 'darkred', 'L3': 'darkorange', 'L4': 'green', 'L5': 'green'}
    for name, (x, y, z) in lagrange.items():
        ax.scatter([x/R_SUN], [y/R_SUN], color=lagrange_colors[name], marker='X', s=100, zorder=5)
        ax.text(x/R_SUN + 1.5, y/R_SUN + 1.5, name, fontsize=12, fontweight='bold')
        
    ax.set_aspect('equal')
    ax.set_xlabel('X ($R_\odot$)', fontsize=12)
    ax.set_ylabel('Y ($R_\odot$)', fontsize=12)
    ax.set_title("Kinematic Engine: Systemic Equipotential Map", fontsize=14)
    ax.legend(loc='upper right')
    ax.grid(True, linestyle=':', alpha=0.6)
    plt.tight_layout()
    plt.show()
def plot_3d_system(geometry: dict, temp: dict, orbit: OrbitalSolution, params: SystemParameters, lagrange: dict, disk_radius_Rsun: float = 32.10):
    """Renders the 3D Roche lobe mesh mapped with iterative surface temperatures and the accretion disk."""
    fig = plt.figure(figsize=(10, 10))
    ax = fig.add_subplot(111, projection='3d')
    ax.set_facecolor('black')
    fig.patch.set_facecolor('black')

    X, Y, Z = geometry["X_Rsun"], geometry["Y_Rsun"], geometry["Z_Rsun"]
    Tmap = temp["Tmap_K"]

    norm = plt.Normalize(vmin=np.nanmin(Tmap), vmax=np.nanmax(Tmap))
    cmap = cm.inferno  
    colors = cmap(norm(Tmap))

    ax.plot_surface(X, Y, Z, facecolors=colors, shade=False, antialiased=True, zorder=1)

    mappable = cm.ScalarMappable(norm=norm, cmap=cmap)
    mappable.set_array(Tmap)
    cbar = plt.colorbar(mappable, ax=ax, shrink=0.5, pad=0.1)
    cbar.set_label('Effective Temperature (K)', color='white')
    cbar.ax.yaxis.set_tick_params(colors='white')
    plt.setp(plt.getp(cbar.ax.axes, 'yticklabels'), color='white')

    a_Rsun = orbit.a_m / R_SUN
    Rg = params.gainer_radius_Rsun
    
    # Render Gainer Core
    u, v = np.linspace(0, 2 * np.pi, 40), np.linspace(0, np.pi, 40)
    Xg = a_Rsun + Rg * np.outer(np.cos(u), np.sin(v))
    Yg = Rg * np.outer(np.sin(u), np.sin(v))
    Zg = Rg * np.outer(np.ones(np.size(u)), np.cos(v))
    ax.plot_surface(Xg, Yg, Zg, color='deepskyblue', alpha=0.7, zorder=2)

    # --- RESTORED ACCRETION DISK ---
    if disk_radius_Rsun > Rg:
        r_disk = np.linspace(Rg, disk_radius_Rsun, 30)
        theta_disk = np.linspace(0, 2 * np.pi, 60)
        R_disk, Theta_disk = np.meshgrid(r_disk, theta_disk)
        
        Xd = a_Rsun + R_disk * np.cos(Theta_disk)
        Yd = R_disk * np.sin(Theta_disk)
        Zd = np.zeros_like(Xd)
        
        # Render as a semi-transparent gold plane
        ax.plot_surface(Xd, Yd, Zd, color='gold', alpha=0.4, zorder=3)

    lagrange_colors = {'L1': 'white', 'L2': 'red', 'L3': 'orange', 'L4': 'lime', 'L5': 'lime'}
    for name, (x, y, z) in lagrange.items():
        lx, ly, lz = x/R_SUN, y/R_SUN, z/R_SUN
        ax.scatter(lx, ly, lz, color=lagrange_colors[name], s=60, edgecolors='white', zorder=5)
        ax.text(lx, ly + 2, lz + 2, name, color='white', fontsize=12, fontweight='bold', zorder=6)

    lim = a_Rsun * 1.0  
    ax.set_xlim(-lim*0.6, lim*1.4)
    ax.set_ylim(-lim, lim)
    ax.set_zlim(-lim, lim)
    ax.set_box_aspect((1, 1, 1))

    ax.set_xlabel('X ($R_\odot$)', color='white')
    ax.set_ylabel('Y ($R_\odot$)', color='white')
    ax.set_zlabel('Z ($R_\odot$)', color='white')
    ax.tick_params(colors='white')
    ax.xaxis.pane.fill = ax.yaxis.pane.fill = ax.zaxis.pane.fill = False
    ax.grid(color='gray', linestyle='--', linewidth=0.5, alpha=0.5)

    plt.title(f"ASTERIA 3D: Dynamic $\\beta$ Temperature Map (q={orbit.q:.3f})", color='white', size=14)
    plt.show()

