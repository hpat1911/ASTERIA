"""
Diagnostic Computational Eclipsing-Binary Modelling Pipeline (Full 2D & 3D Edition)
Includes: Kinematic Parameter Sweep, Fourier Flux Equation, 
Corrected Photometric Luminosity Coupling, and Dynamic Continuous Beta Mapping.
"""

from dataclasses import dataclass
from typing import Optional, Tuple
import numpy as np
from scipy.integrate import solve_ivp
from scipy.optimize import brentq
import os
import matplotlib.pyplot as plt
from matplotlib import cm

# ============================================================
# PHYSICAL CONSTANTS (SI)
# ============================================================
G = 6.67430e-11          
K_B = 1.380649e-23       
SIGMA_SB = 5.670374e-8   
M_SUN = 1.98847e30       
R_SUN = 6.957e8          
L_SUN = 3.828e26         
M_H = 1.6735575e-27      
DAY = 86400.0            
YEAR = 365.25 * DAY      

@dataclass
class SystemParameters:
    period_days: float
    luminosity_Lsun: float
    K1_kms: float = 0.0             
    K2_kms: float = 0.0             
    dP_dt_s_per_year: float = 0.0   
    inclination_deg: float = 90.0   
    eccentricity: float = 0.0
    mean_molecular_weight: float = 1.2
    gamma_gas: float = 5.0 / 3.0
    gainer_radius_Rsun: float = 6.0
    manual_donor_l_sun: Optional[float] = None

@dataclass
class OrbitalSolution:
    q: float
    a1_m: float
    a2_m: float
    a_m: float
    total_mass_kg: float
    M1_kg: float
    M2_kg: float
    omega_rad_s: float
    barycenter_x_m: float


# ============================================================
# KINEMATIC SENSITIVITY SWEEP (i & e)
# ============================================================
def run_kinematic_sweep(P_days: float, K1_kms: float, K2_kms: float, steps: int = 41) -> dict:
    P_sec = P_days * DAY
    K_sum = (K1_kms + K2_kms) * 1000.0
    q = K2_kms / K1_kms  
    
    i_deg = np.linspace(80.0, 90.0, steps)
    e_vals = np.linspace(0.0, 0.20, steps)
    I, E = np.meshgrid(np.radians(i_deg), e_vals)
    
    a_m = (P_sec * K_sum * np.sqrt(1.0 - E**2)) / (2.0 * np.pi * np.sin(I))
    M_tot = (P_sec * (K_sum**3) * ((1.0 - E**2)**1.5)) / (2.0 * np.pi * G * (np.sin(I)**3))
    
    M_donor = (q / (1.0 + q)) * M_tot / M_SUN
    M_gainer = (1.0 / (1.0 + q)) * M_tot / M_SUN
    a_Rsun = a_m / R_SUN
    
    return {
        "M_donor_range": (np.min(M_donor), np.max(M_donor)),
        "M_gainer_range": (np.min(M_gainer), np.max(M_gainer)),
        "a_range": (np.min(a_Rsun), np.max(a_Rsun))
    }

# ============================================================
# PHOTOMETRIC DATA REDUCTION 
# ============================================================
def fourier_design_matrix(phase: np.ndarray, order: int = 4) -> np.ndarray:
    phase = np.asarray(phase, dtype=float)
    cols = [np.ones_like(phase)]
    for n in range(1, order + 1):
        cols.append(np.cos(2.0 * np.pi * n * phase))
        cols.append(np.sin(2.0 * np.pi * n * phase))
    return np.column_stack(cols)

def fourier_ols(phase: np.ndarray, magnitude: np.ndarray, order: int = 4) -> Tuple[np.ndarray, float]:
    mask = np.isfinite(phase) & np.isfinite(magnitude)
    p_clean = np.asarray(phase[mask], dtype=float)
    m_clean = np.asarray(magnitude[mask], dtype=float)

    raw_flux = 10.0 ** (-0.4 * (m_clean - np.min(m_clean)))
    baseline = np.percentile(raw_flux, 99) 
    flux = raw_flux / baseline

    M = fourier_design_matrix(p_clean, order)
    beta, *_ = np.linalg.lstsq(M, flux, rcond=None)
    residuals = flux - M @ beta
    return beta, float(np.sum(residuals**2))

def get_fourier_equation(beta: np.ndarray, order: int = 4) -> str:
    eq = f"F(φ) = {beta[0]:.4f}"
    for n in range(1, order + 1):
        A = beta[2 * n - 1]
        B = beta[2 * n]
        if abs(A) > 1e-4:
            eq += f" {'+' if A > 0 else '-'} {abs(A):.4f}*cos({n}*2πφ)"
        if abs(B) > 1e-4:
            eq += f" {'+' if B > 0 else '-'} {abs(B):.4f}*sin({n}*2πφ)"
    return eq

def evaluate_fourier(phi: np.ndarray, beta: np.ndarray, order: int = 4) -> np.ndarray:
    return fourier_design_matrix(phi, order) @ beta

def extract_morphology(beta: np.ndarray, order: int = 4) -> dict:
    phi_grid = np.linspace(0.0, 1.0, 1000)
    f_grid = evaluate_fourier(phi_grid, beta, order)
    
    f_min1 = np.min(f_grid[(phi_grid < 0.15) | (phi_grid > 0.85)])
    f_min2 = np.min(f_grid[(phi_grid > 0.35) & (phi_grid < 0.65)])
    f_max = np.max(f_grid)
    return {"depth_1": f_max - f_min1, "depth_2": f_max - f_min2, "f_max": f_max}

def compute_coupled_luminosity(morphology: dict, R_gainer: float, R_donor: float, L_total: float) -> Tuple[float, float]:
    d1 = max(1e-4, morphology["depth_1"])
    d2 = max(1e-4, morphology["depth_2"])
    
    # FIXED: Beta Lyrae Eclipse Inversion Mapping
    # The shallower eclipse (d2) occurs when the donor is obscured.
    sb_ratio = d2 / d1  
    area_ratio = (R_donor / R_gainer)**2 
    lum_ratio = sb_ratio * area_ratio # L_donor / L_gainer
    
    donor_frac = 1-(lum_ratio / (1.0 + lum_ratio))
    return donor_frac * L_total, donor_frac

# ============================================================
# SPECTROSCOPY, ORBIT, & ROCHE MODEL
# ============================================================
def derive_orbit(params: SystemParameters) -> OrbitalSolution:
    K1, K2 = params.K1_kms * 1e3, params.K2_kms * 1e3
    P = params.period_days * DAY
    sin_i = np.sin(np.deg2rad(params.inclination_deg))
    ecc_factor = np.sqrt(1.0 - params.eccentricity**2)
    
    a1 = K1 * P * ecc_factor / (2.0 * np.pi * sin_i)
    a2 = K2 * P * ecc_factor / (2.0 * np.pi * sin_i)
    a = a1 + a2
    Mtot = (4.0 * np.pi**2 * a**3) / (G * P**2)
    q = K2 / K1
    
    return OrbitalSolution(
        q=q, a1_m=a1, a2_m=a2, a_m=a, total_mass_kg=Mtot, 
        M1_kg=(q / (1.0 + q)) * Mtot, M2_kg=(1.0 / (1.0 + q)) * Mtot,
        omega_rad_s=2.0 * np.pi / P, barycenter_x_m=((1.0 / (1.0 + q)) * Mtot / Mtot) * a
    )

class RocheModel:
    def __init__(self, orbit: OrbitalSolution):
        self.orbit = orbit
        self.M1, self.M2, self.a = orbit.M1_kg, orbit.M2_kg, orbit.a_m
        self.omega, self.x_cm = orbit.omega_rad_s, orbit.barycenter_x_m

    def potential(self, x, y, z=0.0):
        r1 = np.maximum(np.sqrt(x**2 + y**2 + z**2), 1e-12)
        r2 = np.maximum(np.sqrt((self.a - x)**2 + y**2 + z**2), 1e-12)
        return -G * self.M1 / r1 - G * self.M2 / r2 - 0.5 * self.omega**2 * ((x - self.x_cm)**2 + y**2)

    def lagrange_points(self):
        eps = self.a * 1e-7
        def force(x):
            return G * self.M1 * x / (abs(x)**3) + G * self.M2 * (x - self.a) / (abs(x - self.a)**3) - self.omega**2 * (x - self.x_cm)
        return {
            "L1": (brentq(force, eps, self.a - eps), 0.0, 0.0),
            "L2": (brentq(force, self.a + eps, self.a * 5.0), 0.0, 0.0),
            "L3": (brentq(force, -self.a * 5.0, -eps), 0.0, 0.0),
            "L4": (self.a / 2.0, np.sqrt(3.0) * self.a / 2.0, 0.0),
            "L5": (self.a / 2.0, -np.sqrt(3.0) * self.a / 2.0, 0.0),
        }

    def donor_surface_radius(self, nx, ny, nz, xL1):
        phi_L1 = self.potential(xL1, 0.0, 0.0)
        if nx > 0.99999 and abs(ny) < 1e-5 and abs(nz) < 1e-5: return xL1
        def f(r): return self.potential(r * nx, r * ny, r * nz) - phi_L1
        
        r_max = xL1
        while f(1e-4 * self.a) * f(r_max) > 0 and r_max > 1e-4 * self.a:
            r_max *= 0.95
        try: return brentq(f, 1e-4 * self.a, r_max)
        except: return np.nan

    def donor_geometry(self, n_theta=80, n_phi=160):
        points = self.lagrange_points()
        xL1 = points["L1"][0]
        TH, PH = np.meshgrid(np.linspace(0.001, np.pi - 0.001, n_theta), np.linspace(0.0, 2.0 * np.pi, n_phi), indexing="ij")
        R = np.full_like(TH, np.nan, dtype=float)
        
        for i in range(n_theta):
            for j in range(n_phi):
                r = self.donor_surface_radius(np.sin(TH[i, j]) * np.cos(PH[i, j]), np.sin(TH[i, j]) * np.sin(PH[i, j]), np.cos(TH[i, j]), xL1)
                if np.isfinite(r): R[i, j] = r / R_SUN
        return {"theta": TH, "phi": PH, "R_Rsun": R, "X_Rsun": R * np.sin(TH) * np.cos(PH), "Y_Rsun": R * np.sin(TH) * np.sin(PH), "Z_Rsun": R * np.cos(TH), "lagrange": points, "xL1_m": xL1}

def donor_dimensions(geometry: dict, roche: RocheModel) -> dict:
    R, TH, PH, xL1 = geometry["R_Rsun"], geometry["theta"], geometry["phi"], geometry["xL1_m"]
    integrand_v = np.where(np.isfinite(R), (R**3 * np.sin(TH)) / 3.0, 0.0)
    R_vol = (3.0 * float(np.trapezoid(np.trapezoid(integrand_v, PH[0, :], axis=1), TH[:, 0])) / (4.0 * np.pi))**(1.0 / 3.0)
    
    dR_dth, dR_dph = np.gradient(R, TH[:, 0], PH[0, :], edge_order=2)
    safe_sin = np.where(np.abs(np.sin(TH)) < 1e-8, 1e-8, np.sin(TH))
    integrand_a = np.where(np.isfinite(R), R**2 * np.sin(TH) * np.sqrt(1.0 + (dR_dth / R)**2 + (dR_dph / (R * safe_sin))**2), 0.0)
    area = float(np.trapezoid(np.trapezoid(integrand_a, PH[0, :], axis=1), TH[:, 0]))
    
    # RESTORED: Point, Back, Side, Pole Radii
    r_point = xL1 / R_SUN
    r_back = roche.donor_surface_radius(-1.0, 0.0, 0.0, xL1) / R_SUN
    r_side = roche.donor_surface_radius(0.0, 1.0, 0.0, xL1) / R_SUN
    r_pole = roche.donor_surface_radius(0.0, 0.0, 1.0, xL1) / R_SUN
    
    return {"volume_radius_Rsun": R_vol, "surface_area_Rsun2": area, 
            "point_R_Rsun": r_point, "back_R_Rsun": r_back, 
            "side_R_Rsun": r_side, "pole_R_Rsun": r_pole}

# ============================================================
# STEFAN-BOLTZMANN & CONTINUOUS GRAVITY DARKENING
# ============================================================
def derive_teff_avg(luminosity_Lsun: float, surface_area_Rsun2: float) -> float:
    return float(((luminosity_Lsun * L_SUN) / (surface_area_Rsun2 * R_SUN**2 * SIGMA_SB))**0.25)

def calculate_continuous_beta(T_array: np.ndarray) -> np.ndarray:
    beta = np.full_like(T_array, np.nan)
    valid = np.isfinite(T_array)
    beta[valid & (T_array >= 8500)] = 0.25
    beta[valid & (T_array <= 6500)] = 0.08
    mask = valid & (T_array > 6500) & (T_array < 8500)
    if np.any(mask):
        beta[mask] = 0.08 + (0.17 / (1.0 + np.exp(-0.005 * (T_array[mask] - 7500.0))))
    return beta

def gravity_darkening(geometry: dict, roche: RocheModel, Teff_avg_K: float) -> dict:
    X, Y, Z = geometry["X_Rsun"] * R_SUN, geometry["Y_Rsun"] * R_SUN, geometry["Z_Rsun"] * R_SUN
    h = 1e-5 * roche.a
    gx = (roche.potential(X + h, Y, Z) - roche.potential(X - h, Y, Z)) / (2.0 * h)
    gy = (roche.potential(X, Y + h, Z) - roche.potential(X, Y - h, Z)) / (2.0 * h)
    gz = (roche.potential(X, Y, Z + h) - roche.potential(X, Y, Z - h)) / (2.0 * h)
    gmag = np.sqrt(gx**2 + gy**2 + gz**2)
    
    g_pole = abs((roche.potential(0.0, 0.0, np.nanmax(Z) + h) - roche.potential(0.0, 0.0, np.nanmax(Z) - h)) / (2.0 * h))
    
    T_pole = Teff_avg_K
    for _ in range(20):
        initial_beta = calculate_continuous_beta(np.array([T_pole]))[0]
        Tmap = T_pole * (gmag / g_pole)**initial_beta
        for _ in range(5): 
            beta_map = calculate_continuous_beta(Tmap)
            Tmap = T_pole * (gmag / g_pole)**beta_map
            
        current_mean = np.nanmean(Tmap)
        if abs(current_mean - Teff_avg_K) < 0.5: break
        T_pole *= (Teff_avg_K / current_mean)

    return {"g_pole": g_pole, "T_pole_K": float(T_pole), "T_min_K": float(np.nanmin(Tmap)), "Tmap_K": Tmap, "beta_map": beta_map}

